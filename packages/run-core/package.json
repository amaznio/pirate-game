{
  "name": "@pirate/run-core",
  "private": true,
  "version": "0.1.0",
  "description": "The solo voyage: seeded route graphs, supplies, ports and upgrades. Pure and deterministic; no DOM, React or Phaser, and it never touches the match rules.",
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "harness": "tsx scripts/harness.ts"
  },
  "dependencies": {
    "@pirate/game-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
