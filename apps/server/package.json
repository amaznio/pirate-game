{
  "name": "@pirate/server",
  "private": true,
  "version": "0.1.0",
  "description": "Game server: rooms, lobby and one authoritative host per match, over Socket.IO.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit && tsup",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@pirate/game-core": "workspace:*",
    "@types/node": "^22.10.0",
    "socket.io-client": "^4.8.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
