# Copy to .env for local overrides. On Railway set these as service variables.

# Port to listen on. Railway sets this itself; do not set it there.
PORT=3001

# Browser origin(s) allowed to connect, comma separated. Must match the client's
# public URL exactly (scheme + host, no trailing slash). Use * only in development.
CLIENT_ORIGIN=http://localhost:5173

# Most rooms alive at once.
MAX_ROOMS=100

# Minutes an empty room is kept so players can reconnect.
IDLE_ROOM_MINUTES=10
