# Copy to .env.local for local overrides. On Railway set it as a service variable.

# Public URL of the game server (https://...). Baked into the build, so the client
# must be rebuilt if it changes. Leave unset in development: the server on this
# machine at port 3001 is used. A production build without it has no online play.
VITE_SERVER_URL=http://localhost:3001
