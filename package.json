{
  "name": "pirate-game",
  "private": true,
  "version": "0.1.0",
  "description": "Battle Navigation: a grid-based naval tactics game (client, server and shared game core).",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @pirate/client dev",
    "dev:client": "pnpm --filter @pirate/client dev",
    "build": "pnpm -r build",
    "build:client": "pnpm --filter @pirate/client build",
    "start:client": "pnpm --filter @pirate/client start",
    "test": "pnpm -r test",
    "test:watch": "pnpm --filter @pirate/game-core test:watch",
    "typecheck": "pnpm -r typecheck"
  }
}
